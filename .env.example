# Copy this file to .env and fill in your IBM Cloud Lite / watsonx.ai
# credentials (issued during the internship's "Registration on IBM
# Academic and IBM Cloud" step) to switch from the offline pattern
# fallback to live IBM Granite generation. Leave unset to run fully
# offline — the app and all tests work either way.

WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
